# Banco novo desta pousada. Para desenvolvimento local, use um arquivo novo.
DATABASE_URL="file:./dev.db"

# Marca e URLs públicas
HOTEL_NAME="Nome da Pousada"
HOTEL_EMAIL="reservas@example.com"
HOTEL_WHATSAPP="5511999999999"
HOTEL_WHATSAPP_LINK="https://wa.me/5511999999999"
NEXT_PUBLIC_HOTEL_WHATSAPP="5511999999999"
NEXT_PUBLIC_HOTEL_WHATSAPP_LINK="https://wa.me/5511999999999"
NEXT_PUBLIC_SITE_URL="http://localhost:3005"
NEXT_PUBLIC_BASE_URL="http://localhost:3005"

# Administração: crie segredos novos e longos para cada pousada.
ADMIN_JWT_SECRET="substitua-por-um-segredo-aleatorio-novo"
ADMIN_BOOTSTRAP_SECRET="substitua-por-outro-segredo-aleatorio-novo"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="troque-esta-senha-antes-de-publicar"

# Mercado Pago: nunca reutilize tokens de outra pousada.
NEXT_PUBLIC_MP_PUBLIC_KEY="TEST-sua-chave-publica"
MP_ACCESS_TOKEN="TEST-seu-token-de-acesso"
MP_WEBHOOK_SECRET="crie-um-segredo-para-o-webhook"

# E-mail transacional
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="usuario@example.com"
SMTP_PASS="substitua-por-senha-ou-chave-de-app"
CONTACT_RECEIVER_EMAIL="reservas@example.com"

# Opcionais
SENTRY_DSN=""
GA4_MEASUREMENT_ID=""
GA4_API_SECRET=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
ENABLE_TEST_PAYMENTS="false"
NEXT_PUBLIC_ENABLE_TEST_PAYMENTS="false"
